# Copie para .env e preencha. O .env NUNCA vai para o git.
# Tutorial de como obter cada valor: README.md > "Credenciais do Meta".

# --- Obrigatórias (o MCP não sobe sem elas) ---
# Token de usuário do sistema (System User). Para a v1 só de leitura basta ads_read;
# criar/alterar anúncio exige ads_management.
META_ACCESS_TOKEN=
# Conta de anúncios, com o prefixo act_
META_AD_ACCOUNT_ID=act_
# Página do Facebook que publica os anúncios
META_PAGE_ID=

# --- Opcionais ---
PRODUCT_LABEL=CCBEU
# Destino padrão dos anúncios (sem isso, create_ad exige link_url)
DEFAULT_LINK_URL=
DEFAULT_COUNTRIES=BR
DEFAULT_CTA=LEARN_MORE
# Valores fixos escritos dentro do link, ex.: utm_source=meta&utm_medium=paid
DEFAULT_UTM=
# Parâmetros de URL do criativo, aceita variáveis, ex.: utm_source=meta&utm_content={{ad.name}}
DEFAULT_URL_TAGS=
# Teto do orçamento diário em CENTAVOS (5000 = R$ 50,00). Trava de segurança.
MAX_DAILY_BUDGET=5000

# --- Só para diagnóstico de token (opcionais, usados pelo check de token) ---
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_PIXEL_ID=
